# Copie este arquivo para .env e preencha com os dados do SEU MySQL.
# Nunca envie o arquivo .env para o GitHub.

PORT=3333
# Endereço do frontend (Vite). Separe vários com vírgula.
CORS_ORIGIN=http://localhost:5173

# MySQL (o mesmo servidor que você usa no MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_CONCESSIONARIA=concessionaria_db
DB_FINANCEIRO=financeiro_db

# Segredo para assinar os tokens de login: use um texto longo e aleatório (mínimo 16 caracteres)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# Percentual padrão de comissão do vendedor sobre o valor líquido da venda
COMISSAO_PERCENTUAL_PADRAO=2
